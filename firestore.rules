rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Usernames are read openly because the sign-up flow checks username
    // uniqueness BEFORE the user is authenticated. Writes are restricted to
    // the owner of the document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Quizzes
    match /quizzes/{quizId} {
      // Anyone with the link can read a quiz to answer it.
      allow get: if true;
      // Any signed-in user may list (the client always scopes to its own uid).
      allow list: if request.auth != null;
      // Only the owner may create / edit / delete their quiz.
      allow create, update, delete:
        if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Responses
    match /responses/{responseId} {
      // Anyone (anonymous) can submit an answer.
      allow create: if true;
      // Only the owning quiz's author can read responses.
      allow read:
        if request.auth != null
        && get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.userId == request.auth.uid;
    }

    // Groups (anonymous "who's most ___" voting among a named group)
    match /groups/{groupId} {
      // Anyone with the link can read a group — both to vote and to see results.
      allow get: if true;
      // Any signed-in user may list (the client scopes to its own uid).
      allow list: if request.auth != null;
      // Only the owner may create their group...
      allow create:
        if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Owner may edit or delete it; anyone with the link can add a member to the squad
      allow update:
        if (request.auth != null && resource.data.userId == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      allow delete:
        if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Group votes — anonymous ballots. Results are public (link-based),
    // so anyone can both cast a vote and read the tallied votes.
    match /groupVotes/{voteId} {
      allow create: if true;
      allow read: if true;
    }
  }
}
